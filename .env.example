# ============================================================
# Enterprise Agentic RAG Assistant — Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# ── Google Gemini ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Tavily Web Search ─────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Vector Database ───────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=enterprise_rag_docs

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_BATCH_SIZE=100

# ── Retrieval Settings ────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANKER_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# ── Provider Selection ────────────────────────────────────────
# Options: groq | gemini | ollama
LLM_PROVIDER=gemini
# Options: local | gemini | ollama
EMBEDDING_PROVIDER=gemini

# ── LLM Settings ─────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=8192

# ── Groq Settings ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama Settings ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Document Processing ───────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIR=./data

# ── API Server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# ── API Authentication ────────────────────────────────────────
# Set a strong random secret to protect destructive endpoints:
#   DELETE /documents/{id}, DELETE /memories, POST /reload, etc.
# Leave empty to disable auth (suitable for local development only).
# Example: API_KEY=supersecretkey123
# Clients must send: X-API-Key: <value>
API_KEY=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or "*" for wildcard.
# IMPORTANT: Using "*" automatically disables credentials (browser requirement).
# For production, set this to your frontend's actual origin.
# Example: ALLOWED_ORIGINS=https://myapp.example.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Conversation Memory ───────────────────────────────────────
MAX_MEMORY_TURNS=10
